# ARIA Node — environment configuration
# Copy this to .env and fill in your values.

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# ── x402 Payment Gateway ──────────────────────────────────────────────────────
# Hedera account that receives payments (payTo)
X402_PAY_TO=0.0.9185802

# Amount in tinybars (100_000_000 = 1 HBAR)
X402_AMOUNT=100000000

# Asset: "0.0.0" for HBAR, or an HTS token ID
X402_ASSET=0.0.0

# CAIP-2 network string
X402_NETWORK=hedera:testnet

# x402.org facilitator base URL
FACILITATOR_URL=https://x402.org/facilitator

# ── Future: DID Registry ──────────────────────────────────────────────────────
HEDERA_NETWORK=testnet
# NODE_DID=did:hedera:testnet:...

# ── Future: Agent-to-Agent ────────────────────────────────────────────────────
# (no config needed until module is implemented)
